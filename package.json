{
  "name": "baumy-olympics",
  "private": true,
  "version": "0.0.0",
  "description": "Baumy Olympics: household kitchen hub with a chores game, calendar, shopping list and notes",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brain:spec": "pnpm --filter @baumy/web brain:spec",
    "db:local:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:local:migrate": "NEON_LOCAL_PROXY=1 DATABASE_URL=postgres://postgres:postgres@localhost:54329/baumy pnpm --filter @baumy/db exec tsx scripts/migrate-local.ts",
    "db:local:seed": "NEON_LOCAL_PROXY=1 DATABASE_URL=postgres://postgres:postgres@localhost:54329/baumy DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:54329/baumy pnpm --filter @baumy/db db:seed",
    "db:local:test": "NEON_LOCAL_PROXY=1 DATABASE_URL=postgres://postgres:postgres@localhost:54329/baumy pnpm --filter @baumy/db --filter @baumy/web test:local",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  }
}
