# Baumy Olympics: example environment variables.
# Copy to apps/web/.env.local and fill in.
#
# Every new variable goes here AND into turbo.json `globalEnv` in the same PR
# (AGENTS.md).

# --- Database (packages/db) -------------------------------------------------
# Unset is fine for `next build` and the unit tests: the drivers fall back to a
# placeholder URL that nothing listens on, and the PGlite tests need no URL.
#
# Neon: DATABASE_URL is the POOLED endpoint (host contains `-pooler`), used by
# the app. DATABASE_URL_UNPOOLED is the DIRECT endpoint, used by
# `db:migrate` and `db:studio`, because a migration must not run through
# PgBouncer.
#
# Local Docker stack (`pnpm db:local:up`): use the values below as they are.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/baumy
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:54329/baumy
# 1 = send both Neon drivers to the local proxies on localhost:5433 (WebSocket)
# and localhost:4444 (HTTP), and read over the WebSocket pool. Local and e2e
# only; never set it on Vercel.
NEON_LOCAL_PROXY=1

# --- Auth (packages/auth, ADR 0001; owner steps in docs/SETUP.md) ----------
# Unset is fine locally: Better Auth signs with a public placeholder secret.
# On ANY Vercel environment (VERCEL_ENV set) a missing secret fails closed:
# /api/auth/* answers 503 and nobody is signed in. Generate one with
# `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=
# The address people visit, e.g. https://baumy.example. Locally leave it unset
# (Better Auth reads the request's host); the e2e harness sets
# http://localhost:3000.
# BETTER_AUTH_URL=
# Google sign-in, offered only when BOTH are set. Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Resend, for password-reset and confirm-email links. Without both, reset is
# switched off and links are only logged locally.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Baumy Olympics <hello@your-domain>"
# Rate-limit tuning. LEAVE UNSET IN PRODUCTION; the e2e harness raises them.
# AUTH_RATE_LIMIT_WINDOW_SECONDS=
# AUTH_RATE_LIMIT_MAX=
# Set by Vercel itself; listed because the auth base URL and trusted origins
# are derived from them.
# VERCEL_URL=
# VERCEL_BRANCH_URL=
# VERCEL_PROJECT_PRODUCTION_URL=

# --- E2E (scripts/e2e-local.sh sets what it needs; see docs/SETUP.md) ------
# 1 = test mode: the server clock can be moved through POST /api/test/clock
# (apps/web/lib/clock.ts) and, later, integrations are faked. The app refuses
# to build or start with it set on Vercel (any VERCEL_ENV). Leave it unset
# in .env.local unless you are running e2e by hand.
# E2E_TEST_MODE=1
# Set by Vercel itself; listed because the test-mode boot guard reads it.
# VERCEL_ENV=
# Harness knobs, all optional:
# E2E_BASE_URL=http://localhost:3000   # localhost only; anything else is refused
# E2E_SERVE=dev                        # dev | build (build is the CI default)
# E2E_RESET_DB=1                       # drop the public and drizzle schemas first
# E2E_PROJECTS="desktop-chromium ipad-landscape mobile-360"
# E2E_WORKERS=2
# E2E_RETRIES=1                        # CI only
# E2E_TEST_TIMEOUT=60000
# E2E_EXPECT_TIMEOUT=10000
# E2E_ACTION_TIMEOUT=15000
# E2E only: auth emails are appended to this file instead of sent, so a spec
# can follow a reset link. Honoured only with E2E_TEST_MODE=1 and off Vercel.
# scripts/e2e-local.sh sets it.
# AUTH_EMAIL_CAPTURE_FILE=
