{
  "name": "@baumy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "vercel-build": "pnpm --filter @baumy/db db:migrate && pnpm --filter @baumy/db db:seed && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "test:local": "vitest run --config vitest.local.config.ts",
    "brain:spec": "vitest run lib/brain/operations-spec.test.ts --update",
    "help:corpus": "vitest run lib/help/corpus.test.ts --update",
    "logo:png": "BAUMY_WRITE_LOGO=1 vitest run lib/brand/logo-files.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@baumy/ai-prompts": "workspace:*",
    "@baumy/auth": "workspace:*",
    "@baumy/core": "workspace:*",
    "@baumy/db": "workspace:*",
    "@baumy/types": "workspace:*",
    "@baumy/ui": "workspace:*",
    "@better-auth/passkey": "1.6.25",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@simplewebauthn/browser": "13.3.0",
    "@vercel/blob": "^2.8.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.3",
    "mcp-handler": "1.1.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@baumy/eslint-config": "workspace:*",
    "@baumy/typescript-config": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
