{
  "name": "@baumy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./household": "./src/household.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./members": "./src/members.ts",
    "./invite-codes": "./src/invite-codes.ts",
    "./telegram-link-codes": "./src/telegram-link-codes.ts",
    "./login-requests": "./src/login-requests.ts",
    "./kiosk-devices": "./src/kiosk-devices.ts",
    "./kiosk-pin": "./src/kiosk-pin.ts",
    "./seasons": "./src/seasons.ts",
    "./completions": "./src/completions.ts",
    "./confirmations": "./src/confirmations.ts",
    "./chores": "./src/chores.ts",
    "./scores": "./src/scores.ts",
    "./weights": "./src/weights.ts",
    "./sweep": "./src/sweep.ts",
    "./test-harness": "./src/__tests__/_harness.ts",
    "./game-fixtures": "./src/__tests__/_game-fixtures.ts",
    "./notes": "./src/notes.ts",
    "./reminders": "./src/reminders.ts",
    "./avatars": "./src/avatars.ts",
    "./ai-usage": "./src/ai-usage.ts",
    "./mcp-oauth": "./src/mcp-oauth.ts",
    "./service-tokens": "./src/service-tokens.ts",
    "./account-security": "./src/account-security.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:watch": "vitest",
    "db:seed": "tsx scripts/seed.ts",
    "service-token": "tsx scripts/service-token.ts"
  },
  "dependencies": {
    "@baumy/core": "workspace:*",
    "@baumy/types": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@baumy/eslint-config": "workspace:*",
    "@baumy/typescript-config": "workspace:*",
    "@electric-sql/pglite": "^0.5.3",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
