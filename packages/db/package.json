{
  "name": "@baumy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./household": "./src/household.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./members": "./src/members.ts",
    "./invite-codes": "./src/invite-codes.ts",
    "./telegram-link-codes": "./src/telegram-link-codes.ts",
    "./test-harness": "./src/__tests__/_harness.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@baumy/eslint-config": "workspace:*",
    "@baumy/typescript-config": "workspace:*",
    "@electric-sql/pglite": "^0.5.3",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
